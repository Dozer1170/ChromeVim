{
  "manifest_version": 3,
  "name": "ChromeVim",
  "version": "1.0.0",
  "description": "Vim-style keyboard navigation for Chrome: link hints, scrolling, and normal/insert modes in text fields.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/textops.js", "content/vim.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "permissions": ["tabs"]
}
